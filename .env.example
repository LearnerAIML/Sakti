# SAKTI Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
CORPUS_DIR=data/corpus

# Optional: comma-separated Gemini model IDs (first working one is used)
GEMINI_MODELS=
# Retrieval score below which SAKTI abstains (calibrate with scripts/run_eval.py)
ABSTENTION_THRESHOLD=0.52
# Comma-separated allowed browser origins (same-origin needs none)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Required to read /api/escalations (X-Admin-Token header). Leave empty to disable.
ADMIN_TOKEN=
AUDIT_DIR=data/audit
ADMIN_TOKEN=change_me
# Optional Bhashini adapter switch (see README)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
