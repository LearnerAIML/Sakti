# SAKTI Environment Configuration
GROQ_API_KEY=your_groq_api_key_here
# Groq model to use for LLM synthesis (OpenAI-compatible model name on Groq)
GROQ_MODEL=openai/gpt-oss-120b
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
CORPUS_DIR=data/corpus

# Retrieval score below which SAKTI abstains (calibrate with scripts/run_eval.py)
ABSTENTION_THRESHOLD=0.52
# Comma-separated allowed browser origins (same-origin needs none)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Required to read /api/escalations (X-Admin-Token header). Leave empty to disable.
ADMIN_TOKEN=change_me
AUDIT_DIR=data/audit
# Optional Bhashini adapter switch (see README)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Optional: local embedding model for rebuilding the FAISS index (sentence-transformers model name)
# Only needed if you edit the corpus and run scripts/rebuild_index.py
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
